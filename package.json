{
  "name": "statamic-greenwashing-checker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:check": "vite build --outDir node_modules/.cache/greenwashing-checker-dist",
    "dev": "vite",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run format:check && vendor/bin/pint --test && vue-tsc --noEmit && npm run check:v5",
    "check:v5": "tsc --noEmit -p tsconfig.v5.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@statamic/cms": "file:./vendor/statamic/cms/resources/dist-package"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "3.5.43",
    "laravel-vite-plugin": "^1.2.0",
    "prettier": "^3.5.0",
    "prettier-plugin-antlers": "2.0.8",
    "prosemirror-model": "1.25.12",
    "typescript": "^5.0.0",
    "vite": "^6.1.0",
    "vitest": "4.1.12",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  }
}
